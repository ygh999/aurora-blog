{
  // Aurora Blog - Cloudflare Workers configuration
  // Do NOT commit real database_id or secrets to this file
  "name": "aurora-blog",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurora-blog-db",
      "database_id": "REPLACE_VIA_GITHUB_SECRET_OR_DASHBOARD"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "aurora-blog-assets"
    }
  ]
}
